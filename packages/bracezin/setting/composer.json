{
    "name": "bracezin/setting",
    "description": "It Maintain All Settings",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jeyakumar",
            "email": "jeyaasok@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": { },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "classmap": [
            "database/factories",
            "database/migrations",
            "database/seeders",
            "src/Models",
            "src/Repositories",
            "src/Imports",
            "src/Observers"
        ],
        "psr-4": {
            "Setting\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Setting\\SettingServiceProvider"
            ],
            "aliases": {
                "Setting" : "Setting\\Facades\\Setting"
            }
        },
        "merge-plugin": {
            "ignore-duplicates": true
        }
    }
}
